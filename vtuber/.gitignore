# ══════════════════════════════════════════════════════
#  .gitignore
# ══════════════════════════════════════════════════════

# ── 密钥（绝对不能进 git）────────────────────────────
.env

# ── 虚拟环境（换台电脑重新 pip install -r requirements.txt）──
.venv/
venv/

# ── Python 杂物 ──────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── 运行产物（TTS 存下来的声音、日志）────────────────
output.pcm
output.wav
*.log

# ── 编辑器 ───────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store

# 运行日志（每次跑都会写）
弹幕日志.txt

# ── 运行时数据库（含观众弹幕，属于隐私，不入库）──────────
记忆.db
记忆.db-shm
记忆.db-wal
*.db
*.db-shm
*.db-wal

# ── 运行时状态 ────────────────────────────────────────
卖货文档/.当前文档

# ── 与项目无关的本地练习脚本 ─────────────────────────────
_sql_练手.py
_sql_练手.db
