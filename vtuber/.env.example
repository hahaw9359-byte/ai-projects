# ══════════════════════════════════════════════════════
#  复制本文件为 .env，填入真实密钥：  cp .env.example .env
# ══════════════════════════════════════════════════════

# ── DeepSeek 大模型 ────────────────────────────────────
# 从 https://platform.deepseek.com 拿
Deepseek_key=""

# ── 小脑开智（可选）────────────────────────────────────
#   1 = 启用：粗筛命中"产品问题"时，小脑先问一次模型，把问题提纯成一句话
#   不填 = 关闭（默认关，避免意外花钱）
#   Deepseek_key_小脑 = 单独给小脑用的 key（没配就回落到 Deepseek_key）
小脑开智=""
Deepseek_key_小脑=""

# ── 火山引擎 语音合成 ──────────────────────────────────
# 从火山控制台 → API Key 管理 / 音色库 拿
VOLC_API_KEY=""
VOLC_SPEAKER="zh_female_vv_uranus_bigtts"
VOLC_RESOURCE="seed-tts-2.0"

# ── B站直播间（接真弹幕）───────────────────────────────
# 直播间地址栏里的那串数字，比如 live.bilibili.com/9369961 → 填 9369961
# 空着 = 安静模式（只有卖货填充，不响应弹幕）
BILI_ROOM_ID=""
